  var d=Object.getOwnPropertyDescriptor(Document.prototype,"pointerLockElement");
  var realGet=d&&d.get;
  try{
    Object.defineProperty(Document.prototype,"pointerLockElement",{
      configurable:true,
      get:function(){
        if(faked) return target;
        return realGet?realGet.call(this):null;
      }
    });
  }catch(e){}
  function fire(){
    try{ document.dispatchEvent(new Event("pointerlockchange")); }catch(e){}
    try{ document.dispatchEvent(new Event("mozpointerlockchange")); }catch(e){}
    try{ document.dispatchEvent(new Event("webkitpointerlockchange")); }catch(e){}
  }
  function lock(){
    if(faked) return;
    target=document.getElementById("canvas");
    if(!target) return;
    faked=true;
    try{ target.focus(); }catch(e){}
    fire();
  }
  function unlock(){
    if(!faked) return;
    faked=false; target=null; fire();
  }
  /* Orijinal exitPointerLock'i da sahte kilide bagla */
  var realExit=Document.prototype.exitPointerLock;
  Document.prototype.exitPointerLock=function(){
    if(faked){ unlock(); return; }
    try{ if(realExit) realExit.call(this); }catch(e){}
  };
  document.addEventListener("click",function(){
    if(!document.pointerLockElement) lock();
  },true);
  document.addEventListener("keydown",function(e){
    if(e.key==="Escape"||e.keyCode===27) unlock();
  },true);
  /* Oyun hazir olunca ilk tiklamayi beklemeden kilitli say (overlay hic cikmasin) */
  window.__fakeLockNow=lock;
})();
