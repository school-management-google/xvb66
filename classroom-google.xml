/* ── SAHTE POINTER LOCK ──────────────────────────────────────────────
   iframe sandbox'ta gercek kilit alinamadigi icin document.pointerLockElement
   hep null kaliyor -> oyun "Click to play" katmanini kapatmiyor.
   Burada kilidi taklit edip pointerlockchange olayini kendimiz atiyoruz.
   Fare bakisi movementX/movementY ile kilitsiz de calisir.            */
(function(){
